<?xml version="1.0" encoding="UTF-8"?>
<!-- pom.xml para el módulo 'cargadorDinamica' -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.example</groupId>
    <artifactId>MetaMapa</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!-- Se define explícitamente el groupId tal como pediste -->
  <groupId>org.example</groupId>
  <artifactId>cargadorDinamica</artifactId>
  <name>cargadorDinamica</name>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Hereda Java 21 del padre -->
  </properties>

  <dependencies>
    <!-- Lombok actualizado (scope provided para compilación/IDE) -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.30</version>
      <scope>provided</scope>
    </dependency>

    <!-- Tests: usar el starter de Spring Boot para heredar versiones y evitar el error de JUnit -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>